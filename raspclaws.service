[Unit]
Description=RaspClaws FastAPI control server
After=network-online.target
Wants=network-online.target

[Service]
# 경로와 사용자 이름은 실제 환경에 맞게 수정하세요
User=pi
WorkingDirectory=/home/pi/raspclaws-fastapi
ExecStart=/home/pi/raspclaws-fastapi/.venv/bin/python run.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
